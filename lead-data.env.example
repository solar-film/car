# Lead menu settings only. Keep secrets on the SERVER, never in HTML or chat.
CAR_LEAD_PORT=3092
CAR_LEAD_HOST=127.0.0.1
# Required (32+ characters) before opening service to other machines.
CAR_LEAD_ACCESS_KEY=
# CAR_LEAD_DATABASE=/persistent-data/car-leads.sqlite
# CAR_LEAD_ALLOWED_ORIGIN=https://your-car-crm-site.example

# LINE CAR @maholan
# Read existing CAR-only sheet metadata; keep the original webhook unchanged.
CAR_LEAD_LINE_SOURCE=sheet
CAR_LEAD_LINE_CHANNEL_SECRET=
CAR_LEAD_LINE_ACCESS_TOKEN=
CAR_LEAD_LINE_BOT_USER_ID=

# Facebook CAR: https://www.facebook.com/MHLcarfilm
# Read-only Conversations API requires Page ID + Page Access Token.
# APP_SECRET / VERIFY_TOKEN below are only for optional native webhooks.
CAR_LEAD_FB_PAGE_ID=
CAR_LEAD_FB_APP_SECRET=
CAR_LEAD_FB_VERIFY_TOKEN=
CAR_LEAD_FB_PAGE_ACCESS_TOKEN=

# Instagram CAR @mhlcarfilm, linked to the same CAR Facebook Page.
# Read-only; keeps Facebook/LINE credentials, webhooks and subscriptions intact.
# Facebook Login permissions: instagram_basic, instagram_manage_messages,
# pages_manage_metadata. Real customer chats require Meta Advanced Access.
CAR_LEAD_IG_ACCOUNT_ID=17841458662245781
CAR_LEAD_IG_USERNAME=mhlcarfilm
# Optional separate PAGE Access Token; blank reuses the existing CAR Page token.
# An Instagram Login token uses a different API and is not supported here.
CAR_LEAD_IG_PAGE_ACCESS_TOKEN=

# Full CRM authentication (same-origin Node hosting). Hash format: salt:hex-scrypt.
CAR_CRM_AUTH_USER=admin
CAR_CRM_AUTH_PASSWORD_HASH=
CAR_CRM_AUTH_COMMISSION_HASH=
# Exact HTTPS origin for remote CRM hosting; leave empty for loopback-only use.
CAR_CRM_PUBLIC_ORIGIN=
