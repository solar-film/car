# EXAMPLE ONLY. Copy outside the bundle and repository; never commit real values.
# Generate a private CAR-specific Access Key of at least 32 characters before launch.
CAR_LEAD_ACCESS_KEY=
CAR_LEAD_HOST=0.0.0.0
CAR_LEAD_PORT=10000
CAR_LEAD_DATABASE=/var/data/car-leads.sqlite
CAR_LEAD_ALLOWED_ORIGIN=https://solar-film.github.io

# Existing CAR LINE activity is read through its sheet; do not change LINE routing.
CAR_LEAD_LINE_SOURCE=sheet
CAR_LEAD_LINE_ACCESS_TOKEN=
CAR_LEAD_LINE_CHANNEL_SECRET=
CAR_LEAD_LINE_BOT_USER_ID=

# Set only the authorized CAR Page/account and private Page token on the new host.
CAR_LEAD_FB_PAGE_ID=
CAR_LEAD_FB_PAGE_ACCESS_TOKEN=
CAR_LEAD_IG_ACCOUNT_ID=
CAR_LEAD_IG_USERNAME=mhlcarfilm
CAR_LEAD_IG_PAGE_ACCESS_TOKEN=

# Leave receiver credentials empty. This preparation does not register webhooks.
CAR_LEAD_FB_APP_SECRET=
CAR_LEAD_FB_VERIFY_TOKEN=

# Full CRM authentication (same-origin Node hosting). Hash format: salt:hex-scrypt.
CAR_CRM_AUTH_USER=admin
CAR_CRM_AUTH_PASSWORD_HASH=
CAR_CRM_AUTH_COMMISSION_HASH=
# Exact HTTPS origin for remote CRM hosting; leave empty for loopback-only use.
CAR_CRM_PUBLIC_ORIGIN=
